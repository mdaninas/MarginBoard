# Comma-separated list of allowed origins for CORS.
# Add your deployed frontend URL here in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Override location of the raw dataset directory (optional).
# RAW_DATA_DIR=

# Logging — DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 'console' for local readable output, 'json' for log aggregator pipelines.
LOG_FORMAT=console

# Set a token to enable POST /api/admin/refresh.
# Leave unset (or empty) to keep admin endpoints disabled.
# ADMIN_TOKEN=

# Set to 'false' to skip artifact loading at startup (e.g. for CI).
PREWARM_ON_STARTUP=true
